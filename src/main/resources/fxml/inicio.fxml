<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootPane" styleClass="menu-principal" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">

    <!-- Barra superior -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="top-bar" stylesheets="@../css/estilos.css">
            <padding>
                <Insets bottom="10" left="20" right="20" top="10" />
            </padding>

            <Label styleClass="logo-icon" text="🛒" />
            <Label styleClass="logo-text" text="Sistema de Venta" />
        </HBox>
    </top>

    <!-- Contenido principal -->
    <center>
        <VBox alignment="TOP_CENTER" spacing="25">

            <padding>
                <Insets top="40" />
            </padding>

            <Label styleClass="titulo" text="SISTEMA DE VENTA" />

            <Label styleClass="subtitulo" text="Selecciona una opción para continuar" />

            <HBox alignment="CENTER" spacing="40">

                <!-- Panel Ventas -->
                <VBox alignment="CENTER" spacing="15" styleClass="card-venta">

                    <StackPane prefHeight="250" prefWidth="400" styleClass="imagen-venta" />

                    <Label styleClass="card-title" text="VENTA" />

                    <Label styleClass="card-description" text="Realiza ventas, registra productos&#10;y gestiona el carrito." wrapText="true" />

                    <Button styleClass="btn-venta" stylesheets="@../css/estilos.css" text="Ir a Ventas" />
                </VBox>

                <!-- Panel Administración -->
                <VBox alignment="CENTER" spacing="15" styleClass="card-admin">

                    <StackPane prefHeight="250" prefWidth="400" styleClass="imagen-admin" />

                    <Label styleClass="card-title" text="ADMINISTRACIÓN" />

                    <Label styleClass="card-description" text="Gestiona productos, inventario, usuarios&#10;y configuraciones del sistema." wrapText="true" />

                    <Button styleClass="btn-admin" stylesheets="@../css/estilos.css" text="Ir a Administración" />
                </VBox>

            </HBox>

        </VBox>
    </center>

    <!-- Pie -->
    <bottom>
        <HBox alignment="CENTER" styleClass="footer">
            <padding>
                <Insets bottom="15" top="15" />
            </padding>

            <Label text="🏪 Tu negocio, nuestro sistema" />
        </HBox>
    </bottom>
   <stylesheets>
      <URL value="@../css/estilos.css" />
      <URL value="@../css/estilos.css" />
   </stylesheets>

</BorderPane>
